# Copy to .env (setup does this automatically). NEVER put real secrets in this file.
# Real values live in .env, which is git-ignored.

APP_NAME="Local AI Task Automation System"
# development | test | production
APP_ENV=development
# Loopback only by default (spec NFR-020). Non-loopback hosts are rejected unless
# ALLOW_NON_LOCAL_BIND=true is set deliberately (LAN exposure is out of scope).
APP_HOST=127.0.0.1
APP_PORT=8000
# Relative paths are resolved against the project root.
DATABASE_PATH=database/automation.db
LOG_LEVEL=INFO

# --- Optional path overrides ---
# BACKUP_DIR=database/backups
# LOGS_DIR=logs
# EVIDENCE_DIR=evidence
# PROFILES_DIR=profiles
# LOG_RETENTION_DAYS=30
# SQLITE_JOURNAL_MODE=WAL
# SQLITE_BUSY_TIMEOUT_MS=5000
# ALLOW_NON_LOCAL_BIND=false

# --- Reserved for later phases (NOT read by Phase 2 code) ---
# BROWSER_EXECUTABLES   (Phase 4/5)  chrome/brave/edge executable paths
# AUTOMATION_PROFILES   (Phase 4/5)  dedicated automation profile locations
# FILE_LIMITS           (Phase 7)    extensions, size, count limits
# SCHEDULER_SETTINGS    (Phase 9)    polling interval, wake horizon
# RETRY_SETTINGS        (Phase 11)   attempts, delays, jitter
# POWER_SETTINGS        (Phase 10)   auto-sleep, inactivity grace, AC policy
